{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nazzelha",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "build": {
    "command": "node tool/build_web.mjs"
  },
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "nazzelha-statistics",
      "database_id": "85009161-46c6-4729-b5e7-7f55517c673d",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
